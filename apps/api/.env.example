# Server Port & Host
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Better Auth Configuration
BETTER_AUTH_SECRET="super-secret-better-auth-token-key-must-be-long-and-random"
BETTER_AUTH_URL="http://localhost:4000"

# Frontend Web Origin for CORS
WEB_ORIGIN="http://localhost:3000"

# NeonDB PostgreSQL Connection
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Gmail SMTP Email Verification
# 1. Generate an App Password at: https://myaccount.google.com/apppasswords
# 2. Add your full Gmail address and the 16-character app password below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
# Meta WhatsApp Business Cloud API (2FA Authentication)
# Template name from Meta WhatsApp Manager: dealflow_auth_verification_template
WHATSAPP_API_TOKEN="your-permanent-or-temporary-meta-whatsapp-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-business-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_OTP_TEMPLATE_NAME="dealflow_auth_verification_template"
WHATSAPP_API_VERSION="v21.0"
