# Worker Instance Configuration
WORKER_ID="worker-01"
WORKER_CONCURRENCY=5
NODE_ENV="development"
LOG_LEVEL="info"
METRICS_INTERVAL_MS=30000

# Redis Connection Options (Choose ONE):
# ----------------------------------------------------
# Option A: Local Redis
REDIS_URL="redis://127.0.0.1:6379"

# Option B: Upstash Redis TCP/TLS (Recommended for BullMQ)
# Copy the 'rediss://...' URL from Upstash Console -> Connect -> ioredis / Node.js
# REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-endpoint.upstash.io:6379"

# Option C: Upstash REST Credentials (Automatically converted to TLS Redis by the worker)
# UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token-or-password"

# NeonDB PostgreSQL Connection
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
