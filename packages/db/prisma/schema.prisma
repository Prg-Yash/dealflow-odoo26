generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Model: User
/// Use Case: Core user identity, authentication credentials, role-based access control 
/// (Admin, Sales Rep, Sales Manager, Finance, Customer), and tenant membership.
model User {
  id                        String               @id @default(cuid())
  name                      String
  email                     String               @unique
  emailVerified             Boolean              @default(false)
  image                     String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  organizationId            String?
  role                      UserRole             @default(CUSTOMER)
  accounts                  Account[]
  approvalAuditLogs         ApprovalAuditLog[]
  reviewedApprovalSteps     ApprovalStep[]
  respondedCounterProposals CounterProposal[]    @relation("counter_proposal_responder")
  customerProfile           Customer?            @relation("customer_portal_user")
  financeOpsUser            FinanceOpsUser?
  sentInvitations           Invitation[]         @relation("user_invitations")
  jobs                      Job[]
  createdOrgs               Organization[]       @relation("org_creator")
  quotationComments         QuotationComment[]   @relation("comment_author")
  salesManager              SalesManager?
  salesRep                  SalesRepresentative?
  sessions                  Session[]
  organization              Organization?        @relation("user_organization", fields: [organizationId], references: [id])
  createdWarehouses         Warehouse[]          @relation("warehouse_creator")

  @@index([organizationId])
  @@map("user")
}

/// Model: Session
/// Use Case: Active web and API user sessions managed by Better Auth with expiration tracking.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Model: Account
/// Use Case: Authentication provider link (credentials or OAuth) storing secure password hashes.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Model: Verification
/// Use Case: Ephemeral tokens for email verification links and password recovery workflows.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Model: Organization
/// Use Case: Multi-tenant boundary entity representing the business organization and tenant context for all resources.
model Organization {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String?                 @unique
  currency              String                  @default("INR")
  createdById           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  approvalAuditLogs     ApprovalAuditLog[]
  categories            Category[]
  creditNotes           CreditNote[]
  customerTiers         CustomerTier[]
  customers             Customer[]
  discountApprovalRules DiscountApprovalRule[]
  financeOpsUsers       FinanceOpsUser[]
  fulfillmentOrders     FulfillmentOrder[]
  invitations           Invitation[]
  invoices              Invoice[]
  creator               User?                   @relation("org_creator", fields: [createdById], references: [id])
  priceLists            PriceList[]
  recommendations       ProductRecommendation[]
  products              Product[]
  quotations            Quotation[]
  salesManagers         SalesManager[]
  salesReps             SalesRepresentative[]
  subscriptions         Subscription[]
  users                 User[]                  @relation("user_organization")
  warehouses            Warehouse[]

  @@index([createdById])
  @@map("organizations")
}

/// Model: SalesManager
/// Use Case: Sales management profile defining departmental oversight, team hierarchy, and discount approval thresholds.
model SalesManager {
  id                String                @id @default(cuid())
  userId            String                @unique
  organizationId    String
  department        String?               @default("Sales")
  approvalThreshold Float?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reps              SalesRepresentative[]

  @@index([organizationId])
  @@map("sales_managers")
}

/// Model: SalesRepresentative
/// Use Case: Sales representative profile with quota tracking, commission rate, and historical average discount baseline for anomaly detection.
model SalesRepresentative {
  id                    String        @id @default(cuid())
  userId                String        @unique
  organizationId        String
  managerId             String?
  commissionRate        Float?        @default(0)
  targetQuota           Float?
  historicalAvgDiscount Float         @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  customers             Customer[]
  quotations            Quotation[]
  manager               SalesManager? @relation(fields: [managerId], references: [id])
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([managerId])
  @@index([organizationId])
  @@map("sales_representatives")
}

/// Model: FinanceOpsUser
/// Use Case: Finance and operations profile governing second-level high-risk approvals, split fulfillment, and recurring billing reconciliations.
model FinanceOpsUser {
  id                   String       @id @default(cuid())
  userId               String       @unique
  organizationId       String
  department           String?      @default("Finance & Operations")
  canApproveHighRisk   Boolean      @default(true)
  canManageFulfillment Boolean      @default(true)
  canManageBilling     Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("finance_ops_users")
}

/// Model: CustomerTier
/// Use Case: Discount tier governance defining maximum allowed discount ceilings (e.g., Bronze, Silver, Gold, Platinum) per customer classification.
model CustomerTier {
  id              String       @id @default(cuid())
  name            String
  code            String
  discountCeiling Float
  description     String?
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers       Customer[]
  price_lists     PriceList[]  @relation("CustomerTierToPriceList")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customer_tiers")
}

/// Model: Customer
/// Use Case: B2B client company profile with assigned sales representative, pricing tier, payment terms, and linked customer portal user.
model Customer {
  id              String               @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  taxId           String?
  paymentTerms    String?              @default("Net 30")
  billingAddress  String?
  shippingAddress String?
  tierId          String
  salesRepId      String?
  organizationId  String
  portalUserId    String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  creditNotes     CreditNote[]
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portalUser      User?                @relation("customer_portal_user", fields: [portalUserId], references: [id])
  salesRep        SalesRepresentative? @relation(fields: [salesRepId], references: [id])
  tier            CustomerTier         @relation(fields: [tierId], references: [id])
  invoices        Invoice[]
  quotations      Quotation[]
  subscriptions   Subscription[]

  @@index([tierId])
  @@index([salesRepId])
  @@index([organizationId])
  @@map("customers")
}

/// Model: Invitation
/// Use Case: Team member and portal user invitations with cryptographic tokens and lifecycle statuses.
model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           UserRole
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  organizationId String
  invitedById    String
  metadata       Json?            @default("{}")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitedBy      User             @relation("user_invitations", fields: [invitedById], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([token])
  @@map("invitations")
}

/// Model: Category
/// Use Case: Product categorization (Hardware, Services, Subscriptions) enforcing category-specific discount ceilings and target margin benchmarks.
model Category {
  id              String       @id @default(cuid())
  name            String
  slug            String
  type            CategoryType @default(HARDWARE)
  discountCeiling Float
  targetMargin    Float?
  description     String?
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

/// Model: Product
/// Use Case: Sellable catalog item carrying base selling price and unit cost for real-time gross margin calculation and upsell promotion flags.
model Product {
  id                    String                  @id @default(cuid())
  name                  String
  sku                   String
  description           String?
  categoryId            String
  basePrice             Float
  costPrice             Float
  unit                  UnitType                @default(UNIT)
  taxRate               Float                   @default(0.0)
  isPromoted            Boolean                 @default(false)
  isActive              Boolean                 @default(true)
  organizationId        String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  backorders            Backorder[]
  invoiceLines          InvoiceLine[]
  priceListItems        PriceListItem[]
  targetRecommendations ProductRecommendation[] @relation("recommended_product_recommendations")
  sourceRecommendations ProductRecommendation[] @relation("source_product_recommendations")
  variants              ProductVariant[]
  category              Category                @relation(fields: [categoryId], references: [id])
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationLines        QuotationLine[]
  shipmentLines         ShipmentLine[]
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  subscriptionLines     SubscriptionLine[]

  @@unique([organizationId, sku])
  @@index([categoryId])
  @@index([organizationId])
  @@map("products")
}

/// Model: ProductVariant
/// Use Case: Product dimensional/attribute configurations (e.g., port counts, memory capacity, service commitments) with price and cost adjustments.
model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  attributeName     String
  attributeValue    String
  sku               String?
  extraPrice        Float              @default(0.0)
  costPriceDelta    Float              @default(0.0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  backorders        Backorder[]
  invoiceLines      InvoiceLine[]
  priceListItems    PriceListItem[]
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines    QuotationLine[]
  shipmentLines     ShipmentLine[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  subscriptionLines SubscriptionLine[]

  @@index([productId])
  @@map("product_variants")
}

/// Model: PriceList
/// Use Case: Customer tier-specific or currency-specific pricing schedules with contract pricing rules.
model PriceList {
  id             String          @id @default(cuid())
  name           String
  currency       String          @default("INR")
  organizationId String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          PriceListItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer_tiers CustomerTier[]  @relation("CustomerTierToPriceList")

  @@index([organizationId])
  @@map("price_lists")
}

/// Model: PriceListItem
/// Use Case: Specific line item pricing overrides or percentage discounts within a price list.
model PriceListItem {
  id              String          @id @default(cuid())
  priceListId     String
  productId       String
  variantId       String?
  fixedPrice      Float?
  discountPercent Float?
  minQuantity     Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  priceList       PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([priceListId])
  @@index([productId])
  @@index([variantId])
  @@map("price_list_items")
}

/// Model: DiscountApprovalRule
/// Use Case: Governance matrix defining discount ranges and blended risk score thresholds requiring Sales Manager or Finance approval escalation.
model DiscountApprovalRule {
  id                      String       @id @default(cuid())
  name                    String
  minDiscountPercent      Float        @default(0.0)
  maxDiscountPercent      Float
  minBlendedRiskScore     Float        @default(0.0)
  maxBlendedRiskScore     Float
  requiresManagerApproval Boolean      @default(false)
  requiresFinanceApproval Boolean      @default(false)
  escalationLevel         String       @default("SALES_MANAGER")
  description             String?
  organizationId          String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("discount_approval_rules")
}

/// Model: ProductRecommendation
/// Use Case: Product pairing rules for live upsell and cross-sell suggestions based on co-purchase history and margin thresholds.
model ProductRecommendation {
  id                   String       @id @default(cuid())
  sourceProductId      String
  recommendedProductId String
  coPurchaseScore      Float        @default(1.0)
  promotionalTag       String?
  minMarginThreshold   Float        @default(20.0)
  isActive             Boolean      @default(true)
  organizationId       String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendedProduct   Product      @relation("recommended_product_recommendations", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  sourceProduct        Product      @relation("source_product_recommendations", fields: [sourceProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, recommendedProductId])
  @@index([sourceProductId])
  @@index([recommendedProductId])
  @@index([organizationId])
  @@map("product_recommendations")
}

/// Model: Warehouse
/// Use Case: Physical inventory warehouse location with shipping cost weight factor used to optimize split fulfillment decisions.
model Warehouse {
  id                 String          @id @default(cuid())
  name               String
  code               String?
  location           String?
  shippingCostWeight Float           @default(1.0)
  isActive           Boolean         @default(true)
  organizationId     String
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  shipments          Shipment[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  creator            User?           @relation("warehouse_creator", fields: [createdById], references: [id])
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([organizationId])
  @@map("warehouses")
}

/// Model: StockLevel
/// Use Case: Real-time physical inventory count, reserved units, and reorder points per product per warehouse.
model StockLevel {
  id               String          @id @default(cuid())
  warehouseId      String
  productId        String
  variantId        String?
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  reorderPoint     Int             @default(10)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_levels")
}

/// Model: StockMovement
/// Use Case: Historical audit ledger of all inventory additions, reservations, fulfillment deductions, and adjustments.
model StockMovement {
  id           String            @id @default(cuid())
  warehouseId  String
  productId    String
  variantId    String?
  quantity     Int
  movementType StockMovementType
  referenceId  String?
  notes        String?
  createdAt    DateTime          @default(now())
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_movements")
}

/// Model: Quotation
/// Use Case: Central sales order and deal entity tracking commercial terms, totals, live margins, risk scores, and portal access tokens.
model Quotation {
  id                      String              @id @default(cuid())
  quoteNumber             String
  title                   String
  customerId              String
  salesRepId              String
  organizationId          String
  stage                   QuoteStage          @default(DRAFT)
  subtotal                Float               @default(0.0)
  discountTotal           Float               @default(0.0)
  taxTotal                Float               @default(0.0)
  grandTotal              Float               @default(0.0)
  totalCost               Float               @default(0.0)
  grossMargin             Float               @default(0.0)
  grossMarginPercent      Float               @default(0.0)
  blendedRiskScore        Float               @default(0.0)
  requiresManagerApproval Boolean             @default(false)
  requiresFinanceApproval Boolean             @default(false)
  approvalStatus          ApprovalStatus      @default(PENDING)
  portalToken             String              @unique @default(cuid())
  portalAccessExpiresAt   DateTime?
  expiresAt               DateTime
  notes                   String?
  termsAndConditions      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  auditLogs               ApprovalAuditLog[]
  approvalRequest         ApprovalRequest?
  counterProposals        CounterProposal[]
  fulfillmentOrder        FulfillmentOrder?
  invoices                Invoice[]
  comments                QuotationComment[]
  lines                   QuotationLine[]
  customer                Customer            @relation(fields: [customerId], references: [id])
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesRep                SalesRepresentative @relation(fields: [salesRepId], references: [id])
  signature               QuoteSignature?
  subscriptions           Subscription[]

  @@unique([organizationId, quoteNumber])
  @@index([customerId])
  @@index([salesRepId])
  @@index([organizationId])
  @@index([stage])
  @@map("quotations")
}

/// Model: QuotationLine
/// Use Case: Line item in a quotation specifying product, variant, quantity, line discount, cost, live gross margin, and ceiling breach risk points.
model QuotationLine {
  id                String             @id @default(cuid())
  quotationId       String
  productId         String
  variantId         String?
  itemType          CategoryType       @default(HARDWARE)
  description       String?
  quantity          Int                @default(1)
  unitPrice         Float
  costPrice         Float
  discountPercent   Float              @default(0.0)
  discountAmount    Float              @default(0.0)
  netPrice          Float              @default(0.0)
  totalCost         Float              @default(0.0)
  lineMargin        Float              @default(0.0)
  lineMarginPercent Float              @default(0.0)
  categoryCeiling   Float              @default(0.0)
  customerCeiling   Float              @default(0.0)
  isCeilingBreached Boolean            @default(false)
  riskPoints        Float              @default(0.0)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  backorders        Backorder[]
  invoiceLines      InvoiceLine[]
  comments          QuotationComment[]
  product           Product            @relation(fields: [productId], references: [id])
  quotation         Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  shipmentLines     ShipmentLine[]
  subscriptionLines SubscriptionLine[]

  @@index([quotationId])
  @@index([productId])
  @@index([variantId])
  @@map("quotation_lines")
}

/// Model: ApprovalRequest
/// Use Case: Active approval process container governing sequential review steps for discounted quotations.
model ApprovalRequest {
  id               String         @id @default(cuid())
  quotationId      String         @unique
  status           ApprovalStatus @default(PENDING)
  escalationLevel  String         @default("SALES_MANAGER")
  currentStep      Int            @default(1)
  blendedRiskScore Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  steps            ApprovalStep[]

  @@map("approval_requests")
}

/// Model: ApprovalStep
/// Use Case: Individual review milestone (Sales Manager vs Finance) tracking decision status, reviewer ID, comments, and action timestamps.
model ApprovalStep {
  id                String          @id @default(cuid())
  approvalRequestId String
  stepNumber        Int
  level             ApprovalLevel
  status            ApprovalStatus  @default(PENDING)
  reviewerId        String?
  comments          String?
  actionedAt        DateTime?
  createdAt         DateTime        @default(now())
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  reviewer          User?           @relation(fields: [reviewerId], references: [id])

  @@index([approvalRequestId])
  @@index([reviewerId])
  @@map("approval_steps")
}

/// Model: ApprovalAuditLog
/// Use Case: Immutable compliance log tracking every approval submission, decision, rejection reason, and revision request.
model ApprovalAuditLog {
  id             String       @id @default(cuid())
  quotationId    String
  organizationId String
  actorId        String
  actorRole      UserRole
  action         String
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          User         @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([organizationId])
  @@index([actorId])
  @@map("approval_audit_logs")
}

/// Model: FulfillmentOrder
/// Use Case: Central fulfillment lifecycle entity tracking multi-warehouse order execution for confirmed sales quotations.
model FulfillmentOrder {
  id                String            @id @default(cuid())
  fulfillmentNumber String
  quotationId       String            @unique
  organizationId    String
  status            FulfillmentStatus @default(PENDING)
  shippingAddress   String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  backorders        Backorder[]
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation         Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  shipments         Shipment[]

  @@unique([organizationId, fulfillmentNumber])
  @@index([organizationId])
  @@map("fulfillment_orders")
}

/// Model: Shipment
/// Use Case: Physical shipment package originating from a designated warehouse with carrier tracking and transit statuses.
model Shipment {
  id                 String           @id @default(cuid())
  shipmentNumber     String
  fulfillmentOrderId String
  warehouseId        String
  carrier            String?
  trackingNumber     String?
  shippingCost       Float            @default(0.0)
  status             ShipmentStatus   @default(PENDING)
  estimatedDelivery  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lines              ShipmentLine[]
  fulfillmentOrder   FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, shipmentNumber])
  @@index([fulfillmentOrderId])
  @@index([warehouseId])
  @@index([status])
  @@map("shipments")
}

/// Model: ShipmentLine
/// Use Case: Specific product items and quantities allocated to an individual warehouse shipment package.
model ShipmentLine {
  id              String          @id @default(cuid())
  shipmentId      String
  quotationLineId String
  productId       String
  variantId       String?
  quantity        Int             @default(1)
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id])
  quotationLine   QuotationLine   @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  shipment        Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([shipmentId])
  @@index([quotationLineId])
  @@index([productId])
  @@index([variantId])
  @@map("shipment_lines")
}

/// Model: Backorder
/// Use Case: Shortage tracking for deal line items awaiting inventory replenishment across warehouse locations.
model Backorder {
  id                  String           @id @default(cuid())
  fulfillmentOrderId  String
  quotationLineId     String
  productId           String
  variantId           String?
  quantityBackordered Int              @default(1)
  status              BackorderStatus  @default(PENDING_REPLENISHMENT)
  expectedDate        DateTime?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  fulfillmentOrder    FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [productId], references: [id])
  quotationLine       QuotationLine    @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  variant             ProductVariant?  @relation(fields: [variantId], references: [id])

  @@index([fulfillmentOrderId])
  @@index([quotationLineId])
  @@index([productId])
  @@index([variantId])
  @@map("backorders")
}

/// Model: Subscription
/// Use Case: Recurring SaaS license and recurring support contract management with automated renewal and MRR/ARR tracking.
model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String
  quotationId        String?
  customerId         String
  organizationId     String
  status             SubscriptionStatus @default(ACTIVE)
  billingInterval    BillingInterval    @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  currentMrr         Float              @default(0.0)
  currentArr         Float              @default(0.0)
  autoRenew          Boolean            @default(true)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  creditNotes        CreditNote[]
  invoices           Invoice[]
  lines              SubscriptionLine[]
  customer           Customer           @relation(fields: [customerId], references: [id])
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation          Quotation?         @relation(fields: [quotationId], references: [id])

  @@unique([organizationId, subscriptionNumber])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

/// Model: SubscriptionLine
/// Use Case: Specific recurring product items, license counts, and recurring pricing inside an active subscription.
model SubscriptionLine {
  id              String          @id @default(cuid())
  subscriptionId  String
  quotationLineId String?
  productId       String
  variantId       String?
  quantity        Int             @default(1)
  unitPrice       Float
  discountPercent Float           @default(0.0)
  recurringAmount Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         Product         @relation(fields: [productId], references: [id])
  quotationLine   QuotationLine?  @relation(fields: [quotationLineId], references: [id])
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([subscriptionId])
  @@index([quotationLineId])
  @@index([productId])
  @@index([variantId])
  @@map("subscription_lines")
}

/// Model: Invoice
/// Use Case: Accounts receivable billing invoice representing one-time orders or recurring subscription billing cycles.
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String
  quotationId     String?
  subscriptionId  String?
  customerId      String
  organizationId  String
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  paymentTerms    String?       @default("Net 30")
  subtotal        Float         @default(0.0)
  discountTotal   Float         @default(0.0)
  taxTotal        Float         @default(0.0)
  totalAmount     Float         @default(0.0)
  amountPaid      Float         @default(0.0)
  amountRemaining Float         @default(0.0)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creditNotes     CreditNote[]
  lines           InvoiceLine[]
  customer        Customer      @relation(fields: [customerId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  payments        Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

/// Model: InvoiceLine
/// Use Case: Line item breakdown on an invoice detailing product units, rates, discounts, and recurring flags.
model InvoiceLine {
  id              String          @id @default(cuid())
  invoiceId       String
  quotationLineId String?
  productId       String
  variantId       String?
  description     String
  quantity        Int             @default(1)
  unitPrice       Float
  discountPercent Float           @default(0.0)
  totalAmount     Float
  isRecurring     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  quotationLine   QuotationLine?  @relation(fields: [quotationLineId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@index([quotationLineId])
  @@index([productId])
  @@index([variantId])
  @@map("invoice_lines")
}

/// Model: Payment
/// Use Case: Financial transaction settlement against an invoice with payment method and reference tracking.
model Payment {
  id                   String        @id @default(cuid())
  invoiceId            String
  amount               Float
  paymentMethod        PaymentMethod @default(ACH)
  transactionReference String?
  status               PaymentStatus @default(COMPLETED)
  paidAt               DateTime      @default(now())
  notes                String?
  createdAt            DateTime      @default(now())
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

/// Model: CreditNote
/// Use Case: Credit adjustment issued for subscription mid-cycle cancellations, downgrades, or billing concessions.
model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String
  invoiceId        String?
  subscriptionId   String?
  customerId       String
  organizationId   String
  amount           Float
  reason           String
  status           CreditNoteStatus @default(ISSUED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  customer         Customer         @relation(fields: [customerId], references: [id])
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([customerId])
  @@index([organizationId])
  @@index([status])
  @@map("credit_notes")
}

/// Model: QuotationComment
/// Use Case: Interactive comment thread and negotiation notes between customers and sales reps at both overall quote and individual line-item levels.
model QuotationComment {
  id                      String         @id @default(cuid())
  quotationId             String
  quotationLineId         String?
  authorId                String
  authorRole              UserRole       @default(CUSTOMER)
  message                 String
  proposedDiscountPercent Float?
  isResolved              Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  author                  User           @relation("comment_author", fields: [authorId], references: [id], onDelete: Cascade)
  quotation               Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLine           QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([quotationLineId])
  @@index([authorId])
  @@map("quotation_comments")
}

/// Model: CounterProposal
/// Use Case: Structured negotiation counter-proposal submitted by the customer with proposed commercial totals, discounts, notes, and approval routing.
model CounterProposal {
  id                      String                @id @default(cuid())
  quotationId             String
  proposedGrandTotal      Float
  proposedDiscountPercent Float
  customerNotes           String?
  status                  CounterProposalStatus @default(PENDING)
  respondedById           String?
  respondedAt             DateTime?
  responseNotes           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  quotation               Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  respondedBy             User?                 @relation("counter_proposal_responder", fields: [respondedById], references: [id])

  @@index([quotationId])
  @@index([status])
  @@map("counter_proposals")
}

/// Model: QuoteSignature
/// Use Case: Legal e-signature audit record and acceptance confirmation capturing digital signature strokes, signer identity, IP, and timestamp.
model QuoteSignature {
  id            String    @id @default(cuid())
  quotationId   String    @unique
  signedByName  String
  signedByEmail String
  signatureData String
  ipAddress     String?
  userAgent     String?
  signedAt      DateTime  @default(now())
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quote_signatures")
}

/// Model: Job
/// Use Case: Background asynchronous compute tasks processed by the BullMQ worker.
model Job {
  id          String    @id @default(cuid())
  name        String
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  result      Json?
  error       String?
  attempts    Int       @default(0)
  durationMs  Int?
  workerId    String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  logs        TaskLog[]

  @@index([status])
  @@index([type])
  @@index([workerId])
  @@map("jobs")
}

/// Model: ComputeMetric
/// Use Case: System telemetry metrics tracking worker CPU, memory, and task completion rates.
model ComputeMetric {
  id            String   @id @default(cuid())
  workerId      String
  cpuUsage      Float
  memoryUsageMb Float
  activeJobs    Int      @default(0)
  completedJobs Int      @default(0)
  failedJobs    Int      @default(0)
  timestamp     DateTime @default(now())

  @@index([workerId, timestamp])
  @@map("compute_metrics")
}

/// Model: TaskLog
/// Use Case: Execution log entries for background worker jobs with log level and metadata.
model TaskLog {
  id        String   @id @default(cuid())
  jobId     String
  level     LogLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("task_logs")
}

/// Enum: UserRole
/// Use Case: System-wide role taxonomy governing access control, approval authority, and tenant dashboard views.
enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE_OPS
  CUSTOMER
}

/// Enum: InvitationStatus
/// Use Case: Status lifecycle of team member and customer portal onboarding invitations.
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Enum: CategoryType
/// Use Case: High-level classification distinguishing Hardware, Services, and recurring SaaS Subscriptions.
enum CategoryType {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

/// Enum: UnitType
/// Use Case: Unit of measurement for product catalog pricing and invoicing line items.
enum UnitType {
  UNIT
  HOUR
  PROJECT
  MONTH
  USER_MONTH
  YEAR
  PACK
}

/// Enum: QuoteStage
/// Use Case: Commercial sales deal pipeline progression from draft through approval, negotiation, and confirmation.
enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  NEGOTIATION
  CONFIRMED
  CANCELLED
}

/// Enum: ApprovalStatus
/// Use Case: Discount approval state machine tracking pending reviews, approvals, rejections, and revision requests.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

/// Enum: ApprovalLevel
/// Use Case: Tiered escalation hierarchy designating Sales Manager vs Finance Ops review requirements.
enum ApprovalLevel {
  SALES_MANAGER
  FINANCE
}

/// Enum: StockMovementType
/// Use Case: Inventory ledger movement classification (purchase receipts, allocations, fulfillment, adjustments, transfers).
enum StockMovementType {
  PURCHASE_RECEIPT
  ORDER_RESERVED
  ORDER_FULFILLED
  ADJUSTMENT
  TRANSFER
}

/// Enum: FulfillmentStatus
/// Use Case: Overall fulfillment lifecycle state for sales orders across multiple shipments and backorders.
enum FulfillmentStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// Enum: ShipmentStatus
/// Use Case: Physical transit state machine tracking shipment packages from warehouse picking to delivery.
enum ShipmentStatus {
  PENDING
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Enum: BackorderStatus
/// Use Case: Status tracking for out-of-stock items awaiting replenishment or warehouse transfer.
enum BackorderStatus {
  PENDING_REPLENISHMENT
  ALLOCATED
  CANCELLED
}

/// Enum: SubscriptionStatus
/// Use Case: Recurring subscription contract lifecycle state (active, paused, cancelled, expired).
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

/// Enum: BillingInterval
/// Use Case: Cadence for recurring subscription billing cycles and automated invoice generation.
enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// Enum: InvoiceStatus
/// Use Case: Accounts receivable status tracking draft invoices, issued balances, payments, and overdue accounts.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

/// Enum: PaymentMethod
/// Use Case: Supported settlement instruments for customer invoice payments (Credit Card, ACH, Wire, Check).
enum PaymentMethod {
  CREDIT_CARD
  ACH
  WIRE_TRANSFER
  CHECK
}

/// Enum: PaymentStatus
/// Use Case: Transaction settlement status for invoice payments and customer refunds.
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// Enum: CreditNoteStatus
/// Use Case: Lifecycle state of issued credit notes applied toward customer invoices.
enum CreditNoteStatus {
  ISSUED
  APPLIED
  REFUNDED
  VOID
}

/// Enum: CounterProposalStatus
/// Use Case: Lifecycle state machine for customer counter-proposals during quotation negotiation.
enum CounterProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// Enum: JobStatus
/// Use Case: Asynchronous compute worker job lifecycle state machine.
enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Enum: LogLevel
/// Use Case: Severity classification for compute worker task logs.
enum LogLevel {
  INFO
  WARN
  ERROR
}
