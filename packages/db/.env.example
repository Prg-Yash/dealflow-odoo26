# NeonDB PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection string (with ?sslmode=require&pgbouncer=true or pool_timeout=0)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct unpooled connection string (used for schema migrations and prisma push)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
